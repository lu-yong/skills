{
  "about": "Nationalchip Gerrit 实例的唯一登记处。gerrit/scripts/gerrit.py 用它决定查询地址、认证方式和 TLS 处理；commit-gerrit 用它判断推送目标是否是公司 Gerrit。host 取自 base_url；同一实例的其他主机名或 IP 写进该实例的 host_aliases 数组。unmapped_push_hosts 是允许作为推送目标、但没有登记对应哪个实例的主机：推送放行，查询时需要用户指定实例。",
  "instances": {
    "internal": {
      "label": "内部 Gerrit",
      "base_url": "https://git.nationalchip.com/gerrit",
      "auth": "digest",
      "insecure_tls_fallback": false
    },
    "git2": {
      "label": "Git2 内部 Gerrit",
      "base_url": "https://git2.nationalchip.com/gerrit",
      "auth": "basic",
      "insecure_tls_fallback": false
    },
    "external": {
      "label": "外部 Gerrit",
      "base_url": "https://gerrit.nationalchip.com",
      "auth": "basic",
      "insecure_tls_fallback": true
    }
  },
  "unmapped_push_hosts": ["192.168.110.229"]
}
